<idea-plugin>
    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="saffron"
                name="Saffron Language Server"
                icon="ai.saffron.jetbrains.SaffronIcons.FILE"
                factoryClass="ai.saffron.jetbrains.SaffronLanguageServerFactory">
            <description><![CDATA[
            <p>Saffron's language server (<code>saffron lsp</code> from the <code>saffron-ai</code> npm package):
            step completion with recorded/divergent/unrecorded badges, StepSet completion and go-to-definition,
            hover cards, and diagnostics for <code>.saffron</code> and <code>.feature</code> files.</p>
            <p>Needs <code>saffron-ai</code> installed in the project (<code>npm i -D saffron-ai</code>).</p>
            ]]></description>
        </server>

        <fileNamePatternMapping patterns="*.saffron;*.feature"
                                serverId="saffron"
                                languageId="saffron"/>
    </extensions>
    <projectListeners>
        <!-- Starts the server for files already open once a Saffron project appears (SAF-207). -->
        <listener class="ai.saffron.jetbrains.SaffronLanguageServerStarter"
                  topic="ai.saffron.jetbrains.ui.RootsListener"/>
    </projectListeners>
    <actions>
        <!-- A Run lens from saffron lsp: LSP4IJ runs the action named after the lens's command. -->
        <action id="saffron.runScenario"
                class="ai.saffron.jetbrains.SaffronRunScenarioAction"
                text="Run Saffron Scenario"
                description="Run the scenario under a Run lens: saffron run file:name"/>
    </actions>
</idea-plugin>
