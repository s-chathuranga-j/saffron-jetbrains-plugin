<idea-plugin>
    <id>ai.saffron.jetbrains</id>
    <name>Saffron</name>
    <vendor email="genius.chathuranga@gmail.com" url="https://saffron-ai.io">Chathuranga Jayasinghe</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <!-- Optional on purpose. The file type, highlighting, run configurations
         and the tool window need nothing from LSP4IJ, and an IDE build that
         LSP4IJ has not been released for yet (every new EAP, for a while)
         would otherwise refuse the whole plugin. With LSP4IJ installed, the
         language server below is registered; without it, everything else works. -->
    <depends optional="true" config-file="saffron-lsp4ij.xml">com.redhat.devtools.lsp4ij</depends>
    <!-- The Dashboard's embedded browser. From 2026.2 JCEF is its own bundled
         plugin, whose classes a plugin sees only by depending on it; before
         that it is part of the platform and this is ignored. Optional: an IDE
         without it still gets the Dashboard, with Open in Browser. -->
    <depends optional="true" config-file="saffron-jcef.xml">com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- .saffron is a Saffron file: icon + registration; colors come from the
             TextMate grammar below (the file type is TextMate-backed). -->
        <fileType name="Saffron"
                  language="saffron"
                  fieldName="INSTANCE"
                  implementationClass="ai.saffron.jetbrains.SaffronFileType"
                  extensions="saffron"/>

        <textmate.bundleProvider implementation="ai.saffron.jetbrains.SaffronTextMateBundleProvider"/>

        <!-- Run/Debug Configurations → Add New Configuration → Saffron; right-click a
             .saffron file or a folder of them → Run. -->
        <configurationType implementation="ai.saffron.jetbrains.run.SaffronConfigurationType"/>
        <runConfigurationProducer implementation="ai.saffron.jetbrains.run.SaffronRunConfigurationProducer"/>

        <!-- The Saffron tool window: feature files, run buttons, last-run totals. -->
        <toolWindow id="Saffron" anchor="right" icon="ai.saffron.jetbrains.SaffronIcons.TOOL_WINDOW"
                    factoryClass="ai.saffron.jetbrains.ui.SaffronToolWindowFactory"/>

        <!-- Settings → Tools → Saffron: the CI results download limit. -->
        <applicationConfigurable parentId="tools" id="ai.saffron.jetbrains.settings" displayName="Saffron"
                                 instance="ai.saffron.jetbrains.ui.SaffronSettings"/>

        <notificationGroup id="Saffron" displayType="BALLOON"/>
        <postStartupActivity implementation="ai.saffron.jetbrains.SaffronStartupActivity"/>
    </extensions>
</idea-plugin>
