{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Saffron",
  "scopeName": "source.saffron",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#tag"
    },
    {
      "include": "#stepset-definition"
    },
    {
      "include": "#block-keyword"
    },
    {
      "include": "#stepset-invocation"
    },
    {
      "include": "#step"
    },
    {
      "include": "#docstring"
    },
    {
      "include": "#table"
    }
  ],
  "repository": {
    "comment": {
      "match": "^\\s*#.*$",
      "name": "comment.line.number-sign.saffron"
    },
    "tag": {
      "match": "@[^@\\s]+",
      "name": "entity.name.tag.saffron"
    },
    "stepset-definition": {
      "match": "^\\s*(StepSet)(:)\\s*(.*)$",
      "captures": {
        "1": {
          "name": "keyword.control.stepset.saffron"
        },
        "2": {
          "name": "punctuation.separator.saffron"
        },
        "3": {
          "name": "entity.name.function.stepset.saffron"
        }
      }
    },
    "block-keyword": {
      "match": "^\\s*(Feature|Background|Scenario Outline|Scenario Template|Scenario|Examples|Scenarios|Rule)(:)(.*)$",
      "captures": {
        "1": {
          "name": "keyword.control.gherkin.saffron"
        },
        "2": {
          "name": "punctuation.separator.saffron"
        },
        "3": {
          "name": "entity.name.section.saffron",
          "patterns": [
            {
              "include": "#token"
            }
          ]
        }
      }
    },
    "stepset-invocation": {
      "match": "^\\s*(StepSet)\\s+([^:].*)$",
      "captures": {
        "1": {
          "name": "keyword.control.stepset.saffron"
        },
        "2": {
          "name": "entity.name.function.stepset.saffron",
          "patterns": [
            {
              "include": "#argument"
            },
            {
              "include": "#placeholder"
            },
            {
              "include": "#token"
            }
          ]
        }
      }
    },
    "step": {
      "begin": "^\\s*(Given|When|Then|And|But|\\*)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.step.saffron"
        }
      },
      "end": "$",
      "name": "meta.step.saffron",
      "patterns": [
        {
          "include": "#argument"
        },
        {
          "include": "#placeholder"
        },
        {
          "include": "#token"
        }
      ]
    },
    "docstring": {
      "begin": "^\\s*\"\"\"",
      "end": "^\\s*\"\"\"",
      "name": "string.quoted.docstring.saffron"
    },
    "table": {
      "begin": "^\\s*(?=\\|)",
      "end": "$",
      "name": "meta.table.saffron",
      "patterns": [
        {
          "match": "\\|",
          "name": "punctuation.separator.table.saffron"
        },
        {
          "include": "#placeholder"
        },
        {
          "include": "#token"
        }
      ]
    },
    "argument": {
      "match": "\"[^\"]*\"",
      "name": "string.quoted.double.argument.saffron"
    },
    "placeholder": {
      "match": "<[^<>\\s]+>",
      "name": "variable.parameter.placeholder.saffron"
    },
    "token": {
      "match": "\\{(env:[A-Za-z_][A-Za-z0-9_]*|data:[A-Za-z0-9_.-]+|unique:[A-Za-z0-9_-]+(?::digits)?|date(?:[+-]\\d+)?(?::[^}]+)?)\\}",
      "name": "constant.other.token.saffron"
    }
  },
  "fileTypes": [
    "saffron"
  ]
}
